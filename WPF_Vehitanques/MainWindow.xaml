<Window x:Class="WPF_Vehitanques.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       Title="Vehículos" Height="600" Width="1000" WindowStartupLocation="CenterScreen" Icon="Iconos/camionRojo.png" Closed="Window_Closed" Loaded="Window_Loaded" BorderBrush="Blue" WindowState="Maximized"  
       >

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="95*"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
        </Grid.RowDefinitions>
        <Menu  Grid.Row="1" Name="MenuPpal">
            
        </Menu>
        
        <ToolBar  Grid.Column="0" Grid.Row="0" Width="auto">
            <WrapPanel   Orientation="Horizontal"  HorizontalAlignment="Center"    >
                <Button Name="btn_nuevo" Height="50" Width="50" FontFamily="Arial" FontWeight="Bold" Click="btn_nuevo_Click"  Visibility="Collapsed" >
                    <WrapPanel  Height="40" Width="40" >
                        <Image   Height="40" Width="40" Source="Imagenes/blanco.png"  ToolTip=" Nuevo "></Image>
                    </WrapPanel>
                </Button>
            </WrapPanel>
            <WrapPanel  Orientation="Horizontal"  HorizontalAlignment="Center"   >
                <Button Name="btn_grabar" Height="50" Width="50" FontFamily="Arial" FontWeight="Bold" Click="btn_grabar_Click" Visibility="Collapsed" >
                    <WrapPanel  Width="40" Height="40"  >
                        <Image  Width="40" Height="40" Source="Imagenes/grabar.png"  ToolTip=" Grabar "></Image>
                    </WrapPanel>
                </Button>
            </WrapPanel>
            <WrapPanel   Orientation="Horizontal"  HorizontalAlignment="Center"   >
                <Button Name="btn_Actualizar" Height="50" Width="50" FontFamily="Arial" FontWeight="Bold" Visibility="Collapsed" >
                    <WrapPanel Height="40" Width="40" >
                        <Image  Height="40" Width="40" Source="Imagenes/actualizar.png"  ToolTip=" Actualizar "></Image>
                    </WrapPanel>
                </Button>
            </WrapPanel>
            <WrapPanel   Orientation="Horizontal"  HorizontalAlignment="Center"   >
                <Button Name="btn_Eliminar" Height="50" Width="50" FontFamily="Arial" FontWeight="Bold" Visibility="Collapsed" >
                    <WrapPanel Height="40" Width="40" >
                        <Image  Height="40" Width="40" Source="Imagenes/eliminar.png" ToolTip=" Eliminar "></Image>
                    </WrapPanel>
                </Button>
            </WrapPanel>
            <WrapPanel  Orientation="Horizontal"  HorizontalAlignment="Center"   >
                <Button Name="btn_Consultar" Height="50" Width="50" FontFamily="Arial" FontWeight="Bold"  Visibility="Collapsed" Click="btn_Consultar_Click" >
                    <WrapPanel Height="40" Width="40" >
                        <Image  Height="40" Width="40" Source="Imagenes/consultar.png"  ToolTip=" Consultar "></Image>
                    </WrapPanel>
                </Button>
            </WrapPanel>
            <WrapPanel   Orientation="Horizontal"  HorizontalAlignment="Center"   >
                <Button Name="btn_Autorizar" Height="50" Width="50" FontFamily="Arial" FontWeight="Bold" Visibility="Collapsed"  >
                    <WrapPanel Height="40" Width="40" >
                        <Image  Height="40" Width="40" Source="Imagenes/autorizar.png"  ToolTip=" Autorizar "></Image>
                    </WrapPanel>
                </Button>
            </WrapPanel>
            <WrapPanel   Orientation="Horizontal"  HorizontalAlignment="Center"   >
                <Button Name="btn_Salir" Height="50" Width="50" FontFamily="Arial" FontWeight="Bold" Click="btn_Salir_Click"  >
                    <WrapPanel Height="40" Width="40" >
                        <Image  Height="40" Width="40" Source="Imagenes/salir.jpg"  ToolTip=" Salir "></Image>
                    </WrapPanel>
                </Button>
            </WrapPanel>
            <WrapPanel   Orientation="Horizontal"  HorizontalAlignment="Center"   >
                <Button Name="btn_Imprimir" Height="50" Width="50" FontFamily="Arial" FontWeight="Bold"  Visibility="Collapsed" >
                    <WrapPanel Height="40" Width="40" >
                        <Image  Height="40" Width="40" Source="Imagenes/Print.png"  ToolTip=" Imprimir "></Image>
                    </WrapPanel>
                </Button>
            </WrapPanel>
            <WrapPanel   Orientation="Horizontal"  HorizontalAlignment="Center"   >
                <Button Name="btn_Exportar" Height="50" Width="50" FontFamily="Arial" FontWeight="Bold"  Visibility="Collapsed" >
                    <WrapPanel Height="40" Width="40" >
                        <Image  Height="40" Width="40" Source="Imagenes/excel.jpg"  ToolTip=" Exportar "></Image>
                    </WrapPanel>
                </Button>
            </WrapPanel>
            <WrapPanel   Orientation="Horizontal"  HorizontalAlignment="Center"   >
                <Button Name="btn_Acercade" Height="50" Width="50" FontFamily="Arial" FontWeight="Bold"  >
                    <WrapPanel Height="40" Width="40" >
                        <Image  Height="40" Width="40" Source="Imagenes/Info.png"  ToolTip=" Acerca de.. "></Image>
                    </WrapPanel>
                </Button>
            </WrapPanel>

        </ToolBar>
        <ScrollViewer Grid.Column="0" Grid.Row="2" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"    Foreground="Gray" >
            
            <StackPanel  Name="pnl_inicio"    >
                <Image   Source="Imagenes/coltanques_vehiculo.png"   VerticalAlignment="Center"  ></Image>
            </StackPanel>
            
        </ScrollViewer>
        <ToolBar  Grid.Column="0" Grid.Row="3" Width="auto" HorizontalAlignment="Right" Name="tolbarinformacion" >

            <DatePicker Name="dtfechahoy" Background="Transparent" BorderThickness="0"  Height="25"  VerticalContentAlignment="Center"  FontSize="13" IsManipulationEnabled="False"      Focusable="False" >
                <DatePicker.Resources>
                    <Style TargetType="DatePickerTextBox">
                        <Setter Property="IsReadOnly" Value="True" />
                    </Style>
                </DatePicker.Resources>
            </DatePicker>
            <Label Content="Usuario:"></Label>
            <TextBlock Height="30" FontSize="15" Name="txtusuario"></TextBlock>
            <Label Content="Agencia:"></Label>
            <TextBlock Height="30" FontSize="15" Name="txtnombreagencia" ></TextBlock>
            <TextBlock Height="30" FontSize="15" Name="txtagencia" Text="21"></TextBlock>
            <Label Content="Base de Datos:"></Label>
            <TextBlock Height="30" FontSize="15" Name="txtBaseDatos" ></TextBlock>
        </ToolBar>
    </Grid>
</Window>
