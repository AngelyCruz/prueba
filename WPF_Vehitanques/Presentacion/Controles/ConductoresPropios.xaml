                                        </WrapPanel>-->
                        <!--
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>-->
                        
                        <DataGridTemplateColumn Header="Fecha Creación" MaxWidth="120" MinWidth="80" IsReadOnly="true"   CanUserResize="False" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding Path=FechaCreacion}" IsEnabled="False"  >
                                        <DatePicker.Resources>
                                            <Style TargetType="DatePickerTextBox">
                                                <Setter Property="IsReadOnly" Value="True"/>
                                            </Style>
                                        </DatePicker.Resources>
                                    </DatePicker>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Cédula" Binding="{Binding Path=IdConductor}"   Width="auto" IsReadOnly="True"  CanUserResize="False"/>
                        <DataGridTextColumn Header="Nombres" Binding="{Binding Path=Nombres}"  Width="auto"  IsReadOnly="true"    CanUserResize="False"/>
                        <DataGridTextColumn Header="1er Apellido" Binding="{Binding Path=Apellido1}" Width="auto" IsReadOnly="True"  CanUserResize="False"/>
                        <DataGridTextColumn Header="2do Apellido"  Binding="{Binding Path=Apellido2}"   Width="auto" IsReadOnly="True"  CanUserResize="False"/>
                        <!--<DataGridTextColumn Header="Referencia" Binding="{Binding Path=Referencia}"  Width="auto" IsReadOnly="True" />-->
                        <DataGridTemplateColumn Header="Fecha Nacimiento" MaxWidth="120" MinWidth="80" IsReadOnly="true"   CanUserResize="False" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding Path=FechaNacimiento}" IsEnabled="False"  >
                                        <DatePicker.Resources>
                                            <Style TargetType="DatePickerTextBox">
                                                <Setter Property="IsReadOnly" Value="True"/>
                                            </Style>
                                        </DatePicker.Resources>
                                    </DatePicker>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--<DataGridTextColumn Header="Estado" Binding="{Binding Path=Estado}"   Width="auto" IsReadOnly="True" CanUserResize="False" />-->
                        <DataGridTextColumn Header="Licencia" Binding="{Binding Path=Licencia}"  Width="auto" IsReadOnly="True" />
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Path=Cat_Descripcion}" Width="auto" IsReadOnly="True"  CanUserResize="False"/>
                        <DataGridTemplateColumn Header="Fecha Vence Licencia" Width="auto" IsReadOnly="true"   CanUserResize="False" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding Path=FechaVencimiento}" IsEnabled="False"  >
                                        <DatePicker.Resources>
                                            <Style TargetType="DatePickerTextBox">
                                                <Setter Property="IsReadOnly" Value="True"/>
                                            </Style>
                                        </DatePicker.Resources>
                                    </DatePicker>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Empresa" Binding="{Binding Path=RazonSocial}" Width="auto" IsReadOnly="True" CanUserResize="False" />
                       
