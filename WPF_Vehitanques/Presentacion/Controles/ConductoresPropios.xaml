                                            <Button Name="btnActivar"   CommandParameter="{Binding Path=IdPlaca}"   FontFamily="Arial" FontWeight="Bold"   >
                                                <WrapPanel Width="25" Height="25">
                                                    <Image    Width="25" Height="25" Source="/WPF_Vehitanques;component/Iconos/Circle_Green.png"></Image>
                                                </WrapPanel>
                                            </Button>

                                            <Button Name="btnDesactivar"  CommandParameter="{Binding Path=IdPlaca}"   FontFamily="Arial" FontWeight="Bold"   >
