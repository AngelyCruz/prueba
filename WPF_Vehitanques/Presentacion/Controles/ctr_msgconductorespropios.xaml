<UserControl x:Class="WPF_Vehitanques.Presentacion.Controles.ctr_msgconductorespropios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             Width="auto" Height="auto" Loaded="UserControl_Loaded" Name="ctr_msgconductores">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"  Height="auto">
        <StackPanel Height="auto" Orientation="Vertical" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"  ></ColumnDefinition>
                    <ColumnDefinition Width="20*" ></ColumnDefinition>
                    <ColumnDefinition Width="20*" ></ColumnDefinition>
                    <ColumnDefinition Width="15*" ></ColumnDefinition>
                    <ColumnDefinition Width="10*" ></ColumnDefinition>
                    <ColumnDefinition Width="25*" ></ColumnDefinition>
                    <ColumnDefinition Width="5*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>

                </Grid.RowDefinitions>
                <Label  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" HorizontalAlignment="Center" Foreground="Red" Content="Cuando no se encuentran registros puede que el conductor no esté creado, o no sea un afiliado,o no esté activo." FontSize="15"   FontWeight="Bold"></Label>

                <GroupBox Grid.Column="0" Grid.ColumnSpan="7" Grid.Row="1" Grid.RowSpan="14" BorderBrush="Red" BorderThickness="2" Header="BUSCAR CONDUCTORES PARA ENVIAR MENSAJE">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"  ></ColumnDefinition>
                            <ColumnDefinition Width="20*" ></ColumnDefinition>
                            <ColumnDefinition Width="20*" ></ColumnDefinition>
                            <ColumnDefinition Width="5*"></ColumnDefinition>
                            <ColumnDefinition Width="20*" ></ColumnDefinition>
                            <ColumnDefinition Width="20*" ></ColumnDefinition>
                            <ColumnDefinition Width="5*"></ColumnDefinition>
                            <ColumnDefinition Width="5*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label  Grid.Column="1" Grid.Row="1" Content="Id Conductor: " Height="30"  FontSize="13"  VerticalAlignment="Center"   />

                        <Border Grid.Column="2" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                            <TextBox TabIndex="0" Name="txtbusqueda"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="12" VerticalContentAlignment="Center" FontSize="13" KeyDown="textboxt_KeyDown" PreviewKeyDown="txtbusqueda_PreviewKeyDown"    CharacterCasing="Upper" />
                        </Border>
                        <Label  Grid.Column="3" Grid.Row="1" Content="Nombre conductor: " Height="30"  FontSize="13"  VerticalAlignment="Center"   />

                        <Border Grid.Column="4" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                            <TextBox TabIndex="1"  Name="txtnombre"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="12" VerticalContentAlignment="Center" FontSize="13"  PreviewKeyDown="txtnombre_PreviewKeyDown"    CharacterCasing="Upper" />
                        </Border>
                        <!--<StackPanel Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="1"  VerticalAlignment="Center" Visibility="Collapsed"  >
                    <Grid  Width="auto">
                        <Grid.ColumnDefinitions >
                            <ColumnDefinition Width="33*"></ColumnDefinition>
                            <ColumnDefinition Width="33*"></ColumnDefinition>
                            <ColumnDefinition Width="33*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <RadioButton  Grid.Column="0" VerticalAlignment="Center" IsChecked="True"  HorizontalAlignment="Center"   Name="rdiactivo" Content="Activo" ></RadioButton>
                        <RadioButton  Grid.Column="1"  VerticalAlignment="Center" HorizontalAlignment="Center"   Name="rdiInactivo" Content="Inactivo"></RadioButton>
                        <RadioButton  Grid.Column="2"  VerticalAlignment="Center" HorizontalAlignment="Center"  Name="rditodos" Content=" Todos"></RadioButton>
                    </Grid>
                    
                </StackPanel>-->


                        <Button Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="2"  Name="btn_buscar" ToolTip="Buscar Listado de conductores PROPIOS" Height="25" VerticalContentAlignment="Stretch"  HorizontalContentAlignment="Stretch"  Width="25" Click="btn_buscar_Click">
                            <DockPanel Width="25" Height="25">
                                <Image Source="/WPF_Vehitanques;component/Imagenes/Buscar.png" Width="auto"/>
                            </DockPanel>
                        </Button>

                        <StackPanel Name="pnl_Paginacion" Orientation="Horizontal" HorizontalAlignment="Center"  VerticalAlignment="Bottom"   MaxHeight="30" Grid.Row="3" Grid.Column="0 " Grid.ColumnSpan="8">
                            <Button Margin="4,0" Content="Ant." Name="btn_ant" IsEnabled=" false" MinHeight="22" MinWidth="35"  Click="btn_ant_Click"  />
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="Mostrando registros del " Foreground="Black" />
                                <TextBlock Name ="lbl_Inicio" Text="" Foreground="Black" />
                                <TextBlock Text=" al " Foreground="Black" />
                                <TextBlock Name ="lbl_Fin" Text="" Foreground="Black"/>
                                <TextBlock Text=" de " Foreground="Black" />
                                <TextBlock Name ="lbl_Total" Text="" Foreground="Black"/>
                            </StackPanel>
                            <Button Name="btn_sig" Margin="4,0" Content="Sig." MinHeight="22" MinWidth="35"  Click="btn_sig_Click" />
                        </StackPanel >
                        <DataGrid  Name="gridlistadoconductor"  
                                           Width="auto"  
                                           CopyingRowClipboardContent="gridlistadoconductor_CopyingRowClipboardContent"  
                                           CanUserReorderColumns="False" 
                                           FontWeight="Bold" 
                                           FontFamily="Arial"  
                                           CanUserAddRows="False" 
                                           CanUserResizeRows="False"  
                                           CanUserResizeColumns="True" 
                                           AlternatingRowBackground="#BCF9FA"  
                                           AutoGenerateColumns="False" 
                                           Grid.Column="0" 
                                           Grid.Row="4" 
                                           Grid.ColumnSpan="8" 
                                           Grid.RowSpan="10"
                                           ColumnWidth="Auto" 
                                           HorizontalContentAlignment="Center" Cursor="Hand" 
                                           MaxHeight="500"  
                                           HorizontalAlignment="Center"  
                                           VerticalAlignment="Stretch"  CanUserDeleteRows="False" IsEnabled="True" Visibility="Visible"  >
                            <DataGrid.Columns >
                                <DataGridTemplateColumn Header="Asignar" ClipboardContentBinding="{Binding}" MinWidth="50" CanUserResize="False" Width="auto" >
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <WrapPanel Orientation="Horizontal"  HorizontalAlignment="Center" >
                                                <Button Name="btnasignaconductor"  CommandParameter="{Binding Path=IdConductor}"   FontFamily="Arial" FontWeight="Bold" Click="btnasignaconductor_Click"  VerticalContentAlignment="Stretch"  HorizontalContentAlignment="Stretch">
                                                    <WrapPanel Width="60" Height="25" HorizontalAlignment="Center" >
                                                        <Image   Width="20" Height="25" Source="/WPF_Vehitanques;component/Iconos/add_insert.png" ToolTip="Asignar Este conductor para envío de mensajes "></Image>
                                                        <Image  HorizontalAlignment="Center"  Width="35" Height="25" Source="/WPF_Vehitanques;component/Iconos/mobile_marketing.png" ToolTip="Asignar Este conductor para envío de mensajes"></Image>
                                                    </WrapPanel>
                                                </Button>
                                            </WrapPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Cédula" Binding="{Binding Path=IdConductor}"   Width="auto" IsReadOnly="True"  CanUserResize="False"/>
                                <DataGridTextColumn Binding="{Binding Path=Nombre}"  Width="auto" IsReadOnly="true"    CanUserResize="True" >
                                    <DataGridTextColumn.HeaderTemplate >
                                        <DataTemplate>
                                            <Label HorizontalAlignment="Center" Content="Nombre conductor"></Label>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment"
                                    Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Center"  />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Path=CelPre}"  Width="auto" IsReadOnly="true"    CanUserResize="True" >
                                    <DataGridTextColumn.HeaderTemplate >
                                        <DataTemplate>
                                            <Label HorizontalAlignment="Center" Content="Teléfono"></Label>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment"
                                    Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Center"  />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Column="0" Grid.ColumnSpan="7" Grid.Row="15" Grid.RowSpan="16" BorderBrush="Red" BorderThickness="2" Header="CONDUCTORES ASIGNADOS PARA MENSAJE">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"  ></ColumnDefinition>
                            <ColumnDefinition Width="20*" ></ColumnDefinition>
                            <ColumnDefinition Width="20*" ></ColumnDefinition>
                            <ColumnDefinition Width="5*"></ColumnDefinition>
                            <ColumnDefinition Width="20*" ></ColumnDefinition>
                            <ColumnDefinition Width="20*" ></ColumnDefinition>
                            <ColumnDefinition Width="5*"></ColumnDefinition>
                            <ColumnDefinition Width="5*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                            <RowDefinition MinHeight="25" MaxHeight="35"></RowDefinition>
                            
                            <RowDefinition MinHeight="25" MaxHeight="500"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Button Content="VENTANA MENSAJES DE TEXTO" FontFamily="Arial" FontSize="15" FontWeight="Bold" Height="23"  HorizontalAlignment="Center"   Name="btn_VentanaMsg"   Width="270"    Grid.Row="0" Grid.ColumnSpan="8" Grid.Column="0"  VerticalAlignment="Center" Click="btn_VentanaMsg_Click"   />

                        <DataGrid  Name="gridlistadoconductorasignado"  
                                           Width="auto" 
                                           Height="auto"
                                           CopyingRowClipboardContent="gridlistadoconductorasignado_CopyingRowClipboardContent"  
                                           CanUserReorderColumns="False" 
                                            FontWeight="Bold" 
                                            FontFamily="Arial"  
                                            CanUserAddRows="False" 
                                            CanUserResizeRows="False"  
                                            CanUserResizeColumns="True" 
                                            AlternatingRowBackground="#BCF9FA"  
                                            AutoGenerateColumns="False" 
                                            Grid.Column="0" 
                                            Grid.Row="1" 
                                            Grid.ColumnSpan="8" 
                                            Grid.RowSpan="2" 
                                            ColumnWidth="Auto" 
                                            HorizontalContentAlignment="Center" 
                                            Cursor="Hand" 
                                            MaxHeight="500"  
                                            HorizontalAlignment="Center"  
                                            VerticalAlignment="Stretch"  
                                            CanUserDeleteRows="False" 
                                            IsEnabled="True" 
                                            Visibility="Visible"  >
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Retirar Asignación" ClipboardContentBinding="{Binding}" MinWidth="50" CanUserResize="False" Width="auto" >
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <WrapPanel Orientation="Horizontal"  HorizontalAlignment="Center" >
                                                <Button Name="btndeleteconductor"  CommandParameter="{Binding Path=IdConductor}"   FontFamily="Arial" FontWeight="Bold" Click="btndeleteconductor_Click"  >
                                                    <WrapPanel Width="25" Height="25">
                                                        <Image  Width="25" Height="25" Source="/WPF_Vehitanques;component/Iconos/delete.png" ToolTip="Retirar la asignación de este conductor "></Image>
                                                    </WrapPanel>
                                                </Button>
                                            </WrapPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding Path=NombreConductor}"  Width="auto" IsReadOnly="true"    CanUserResize="True" >
                                    <DataGridTextColumn.HeaderTemplate >
                                        <DataTemplate>
                                            <Label HorizontalAlignment="Center" Content="Nombre conductor"></Label>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment"
                                    Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Center"  />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Path=CelConductor}"  Width="auto" IsReadOnly="true"    CanUserResize="True" >
                                    <DataGridTextColumn.HeaderTemplate >
                                        <DataTemplate>
                                            <Label HorizontalAlignment="Center" Content="Teléfono"></Label>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment"
                                    Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Center"  />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>

                </GroupBox>
               
                
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
