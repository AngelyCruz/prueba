<UserControl x:Class="WPF_Vehitanques.Presentacion.Controles.documentosRemolque"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
               Width="auto" Height="auto" Loaded="UserControl_Loaded" Name="DocRemolques">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"  Height="auto">
        <StackPanel Height="auto" >
    <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"  ></ColumnDefinition>
                    <ColumnDefinition Width="20*" ></ColumnDefinition>
                    <ColumnDefinition Width="20*" ></ColumnDefinition>                    
                    <ColumnDefinition Width="15*" ></ColumnDefinition>
                    <ColumnDefinition Width="20*" ></ColumnDefinition>
                    <ColumnDefinition Width="20*" ></ColumnDefinition>
                    <ColumnDefinition Width="5*" ></ColumnDefinition>
                    <ColumnDefinition Width="5*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
                </Grid.RowDefinitions>
                <Label  Grid.Column="2" Grid.Row="1" Content="Placa Del Remolque." Height="30"  FontSize="13"  VerticalAlignment="Center" HorizontalAlignment="Right"    />
                <Border Grid.Column="3" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25" HorizontalAlignment="Stretch" MaxWidth="150" MinWidth="150">
                    <TextBox  Name="txtplaca"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="6" VerticalContentAlignment="Center" MaxWidth ="150" FontSize="13" PreviewKeyDown="txtbusqueda_PreviewKeyDown" KeyUp="txtbusqueda_PreviewKeyDown"    CharacterCasing="Upper" />
                </Border>

                <Button Grid.Column="4" Grid.Row="1" Name="btn_buscar" ToolTip="Buscar Remolque" Height="25" VerticalContentAlignment="Stretch"  HorizontalContentAlignment="Left"   Width="25" Click="btn_buscar_Click"  VerticalAlignment="Top">
                    <DockPanel Width="25" Height="25">
                        <Image Source="/WPF_Vehitanques;component/Imagenes/Buscar.png" Width="auto"/>
                    </DockPanel>
                </Button>


                <DataGrid  Name="gridremolques"  Width="auto"   CanUserReorderColumns="False" FontWeight="Bold" FontFamily="Arial"  CanUserAddRows="False" CanUserResizeRows="False"  CanUserResizeColumns="True" AlternatingRowBackground="#BCF9FA"  AutoGenerateColumns="False" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="6" Grid.RowSpan="4" ColumnWidth="Auto" HorizontalContentAlignment="Center" Cursor="Hand" MaxHeight="500"  HorizontalAlignment="Center"  VerticalAlignment="Stretch"  CanUserDeleteRows="False" IsEnabled="True" Visibility="Visible" ClipboardCopyMode="None"  >
                    <DataGrid.Columns >
                        <DataGridTemplateColumn   IsReadOnly="True"  ClipboardContentBinding="{Binding}" MinWidth="30" CanUserResize="False" Width="auto" >
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Documento Adjunto"></Label>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel Orientation="Horizontal"  HorizontalAlignment="Center" >
                                        <Button Name="btn_Adjuntar"  CommandParameter="{Binding Path=IdPlacaRO}"   FontFamily="Arial" FontWeight="Bold" Click="btn_Adjuntar_Click"   >
                                            <WrapPanel Width="25" Height="25">
                                                <Image Name="imgbtnAdjuntar"   Width="25" Height="25" Source="/WPF_Vehitanques;component/Iconos/document_search.png" ToolTip="Ver Documentos Adjuntos"></Image>
                                            </WrapPanel>
                                        </Button>
                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTextColumn  Binding="{Binding Path=IdPlacaRO}" Width="auto" IsReadOnly="True" >
                            <DataGridTextColumn.HeaderTemplate >
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Placa Remoqlue"></Label>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment"
                                                    Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center"  />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>



                        <DataGridTextColumn  Binding="{Binding Path=Modelo}"  Width="auto" IsReadOnly="True" >
                            <DataGridTextColumn.HeaderTemplate >
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Modelo"></Label>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment"
                                    Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center"  />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn    Binding="{Binding Path=Capacidad}"   Width="auto" IsReadOnly="true"    >
                            <DataGridTextColumn.HeaderTemplate >
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Capacidad"></Label>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment"
                                    Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center"  />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn  Binding="{Binding Path=NumeroEjes}" Width="auto" IsReadOnly="True" >
                            <DataGridTextColumn.HeaderTemplate >
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Número de Ejes"></Label>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment"
                                    Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center"  />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
