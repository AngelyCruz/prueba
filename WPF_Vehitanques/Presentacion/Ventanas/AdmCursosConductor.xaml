<Window x:Class="WPF_Vehitanques.Presentacion.Ventanas.AdmCursosConductor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="administrador cursos Conductor" 
        Height="auto" Width="auto" 
        Name="admcursosconductor"
        Loaded="admcursosconductor_Loaded"        
        WindowStartupLocation="CenterScreen" >
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"  Height="auto">
        <StackPanel Height="auto" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"  ></ColumnDefinition>
                    <ColumnDefinition Width="20*" ></ColumnDefinition>
                    <ColumnDefinition Width="20*" ></ColumnDefinition>
                    <ColumnDefinition Width="5*"></ColumnDefinition>
                    <ColumnDefinition Width="5*"></ColumnDefinition>
                    <ColumnDefinition Width="20*" ></ColumnDefinition>
                    <ColumnDefinition Width="20*" ></ColumnDefinition>
                    <ColumnDefinition Width="5*"></ColumnDefinition>
                    <ColumnDefinition Width="5*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                </Grid.RowDefinitions>
                <Label  Grid.Column="1" Grid.Row="1" Content="Tipo Doc." Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border Grid.Column="2" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <ComboBox  IsEnabled="False"  Name="cbbtipodocumento" Background="Transparent" BorderThickness="0"  Height="25" VerticalContentAlignment="Center" FontSize="13"  TabIndex="1"/>
                </Border>
                <Label  Grid.Column="5" Grid.Row="1" Content="* Número" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border Grid.Column="6" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <TextBox  Name="txtNumdocumento"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="12" VerticalContentAlignment="Center" FontSize="13"    TabIndex="2" IsEnabled="False" />
                </Border>
                <Label Name="lblerror_documenConductor"  Grid.Column="7" Grid.Row="1" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>


                <Label  Grid.Column="1" Grid.Row="2" Content="* Nombre(s)" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border Grid.Column="2"  Grid.ColumnSpan="5" Grid.Row="2" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <TextBox  IsEnabled="False"  Name="txtnombres"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="60" VerticalContentAlignment="Center" FontSize="13"      CharacterCasing="Upper" TabIndex="3"/>
                </Border>
                <Label Name="lblerror_nombresCond"  Grid.Column="7" Grid.Row="2" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
                <Label  Grid.Column="1" Grid.Row="3" Content="* 1er Apellido" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border Grid.Column="2" Grid.Row="3" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <TextBox IsEnabled="False"   Name="txtapellido1"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="50" VerticalContentAlignment="Center" FontSize="13"    CharacterCasing="Upper"  TabIndex="4" />
                </Border>
                <Label Name="lblerror_apellido1Cond"  Grid.Column="3" Grid.Row="3" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
                <Label  Grid.Column="5" Grid.Row="3" Content="* 2do Apellido" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border Grid.Column="6" Grid.Row="3" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <TextBox IsEnabled="False"   Name="txtapellido2"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="50" VerticalContentAlignment="Center" FontSize="13"   CharacterCasing="Upper"  TabIndex="5"/>
                </Border>
                <Label Name="lblerror_apellido2Cond"  Grid.Column="7" Grid.Row="3" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
                <GroupBox Grid.Column="0" Grid.ColumnSpan="9" Grid.Row="4" Grid.RowSpan="4"  Header="Información curso" VerticalContentAlignment="Top"  BorderBrush="Red" >
                    <StackPanel Name="pnl_tipocargavehiculo">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" ></ColumnDefinition>
                                <ColumnDefinition Width="20*"  ></ColumnDefinition>
                                <ColumnDefinition Width="20*"  ></ColumnDefinition>
                                <ColumnDefinition Width="5*" ></ColumnDefinition>
                                <ColumnDefinition Width="20*"  ></ColumnDefinition>
                                <ColumnDefinition Width="20*"  ></ColumnDefinition>
                                <ColumnDefinition Width="5*" ></ColumnDefinition>
                                <ColumnDefinition Width="5*" ></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition MinHeight="25" MaxHeight="30"></RowDefinition>
                                <RowDefinition MinHeight="25" MaxHeight="30"></RowDefinition>
                                <RowDefinition MinHeight="25" MaxHeight="30"></RowDefinition>
                                <RowDefinition MinHeight="25" MaxHeight="30"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label  Grid.Column="1" Grid.Row="0" Content="Módoulo de Cursos" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                            <Border Grid.Column="2" Grid.Row="0" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                                <ComboBox    Name="cbbgrupo" Background="Transparent" BorderThickness="0"  Height="25" VerticalContentAlignment="Center" FontSize="13"  SelectionChanged="cbbgrupo_SelectionChanged"/>
                            </Border>
                            <Label  Grid.Column="1" Grid.Row="1" Content="Tipo Curso" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                            <Border Grid.Column="2" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                                <ComboBox    Name="cbbcurso" Background="Transparent" BorderThickness="0"  Height="25" VerticalContentAlignment="Center" FontSize="13"  SelectionChanged="cbbcurso_SelectionChanged"/>
                            </Border>

                            <Label  Grid.Column="4" Grid.Row="1" Content="Fecha Elaboración Curso" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                            <Border  Grid.Column="5" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                                <DatePicker Name="dtfechacurso" Background="Transparent" BorderThickness="0"  Height="25"  VerticalContentAlignment="Center"  FontSize="13"  CalendarClosed="dtfechacurso_CalendarClosed" >
                                    <DatePicker.Resources>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="IsReadOnly" Value="True"/>
                                        </Style>
                                    </DatePicker.Resources>
                                </DatePicker>
                            </Border>
                            <Label Name="lblerror_fechacurso"  Grid.Column="6" Grid.Row="1" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
                            <Label  Grid.Column="1" Grid.Row="2" Content="Fecha Vigencia Curso" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                            <Border  Grid.Column="2" Grid.Row="2" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                                <DatePicker Name="dtfechavigenciacurso" Background="Transparent" BorderThickness="0"  Height="25"  VerticalContentAlignment="Center"  FontSize="13"   IsEnabled="False"  >
                                    <DatePicker.Resources>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="IsReadOnly" Value="True"/>
                                        </Style>
                                    </DatePicker.Resources>
                                </DatePicker>
                            </Border>
                            <Label Name="lblerror_fechavigenciacurso"  Grid.Column="3" Grid.Row="2" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
                            <Label  Grid.Column="4" Grid.Row="2" Content="Vigencia en Meses" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                            <Border Grid.Column="5" Grid.Row="2" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                                <TextBox  Name="txtvigenciameses"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="2" VerticalContentAlignment="Center" FontSize="13" IsEnabled="False"   />
                            </Border>


                            <Button Content=" GUARDAR CURSO" ToolTip= "Guardar " FontFamily="Arial" FontSize="15" FontWeight="Bold" Height="23"  HorizontalAlignment="Center"   Name="btn_guardar"   Width="AUTO"  Grid.Column="1"  Grid.Row="3" Grid.ColumnSpan="2"  VerticalAlignment="Center" Click="btn_guardar_Click" />
                            <Button Content=" GUARDAR MÓDULO" ToolTip= "Guardar " FontFamily="Arial" FontSize="15" FontWeight="Bold" Height="23"  HorizontalAlignment="Center"   Name="btn_guardarmodulo"   Width="AUTO"  Grid.Column="4"  Grid.Row="3" Grid.ColumnSpan="2"  VerticalAlignment="Center" Click="btn_guardarmodulo_Click" />

                        </Grid>
                    </StackPanel>
                </GroupBox>
                <Label  Grid.Column="5" Grid.Row="6" Content="" Height="30"  FontSize="13"  VerticalAlignment="Center"  Name="lblidnotificacion" Visibility="Collapsed" />               
                <StackPanel Name="pnl_Paginacion" Orientation="Horizontal" HorizontalAlignment="Center"  VerticalAlignment="Bottom"   MaxHeight="30" Grid.Row="9" Grid.Column="0 " Grid.ColumnSpan="8">
                    <Button Margin="4,0" Content="Ant." Name="btn_ant" IsEnabled=" false" MinHeight="22" MinWidth="35" TabIndex="3" Click="btn_ant_Click"  />
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="Mostrando registros del " Foreground="Black" />
                        <TextBlock Name ="lbl_Inicio" Text="" Foreground="Black" />
                        <TextBlock Text=" al " Foreground="Black" />
                        <TextBlock Name ="lbl_Fin" Text="" Foreground="Black"/>
                        <TextBlock Text=" de " Foreground="Black" />
                        <TextBlock Name ="lbl_Total" Text="" Foreground="Black"/>
                    </StackPanel>
                    <Button Name="btn_sig" Margin="4,0" Content="Sig." MinHeight="22" MinWidth="35" TabIndex="4" Click="btn_sig_Click" />
                </StackPanel >
                <DataGrid  Name="gridlistanotificaciones"  Width="auto"    CanUserReorderColumns="False" FontWeight="Bold" FontFamily="Arial"  CanUserAddRows="False" CanUserResizeRows="False"  CanUserResizeColumns="True" AlternatingRowBackground="#BCF9FA"  AutoGenerateColumns="False" Grid.Column="0" Grid.Row="10" Grid.RowSpan="10" Grid.ColumnSpan="8"  ColumnWidth="Auto" HorizontalContentAlignment="Center" Cursor="Hand" MaxHeight="500"  HorizontalAlignment="Center"  VerticalAlignment="Stretch"  CanUserDeleteRows="False" IsEnabled="True" Visibility="Visible" ClipboardCopyMode="None"   >
                    <DataGrid.Columns >
                        <DataGridTemplateColumn   IsReadOnly="True"  ClipboardContentBinding="{Binding}" MinWidth="30" CanUserResize="False" Width="auto" >
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Documento Adjunto"></Label>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel Orientation="Horizontal"  HorizontalAlignment="Center" >
                                        <Button Name="btn_Adjuntar"  CommandParameter="{Binding Path=CurC_Id}"   FontFamily="Arial" FontWeight="Bold" Click="btn_Adjuntar_Click"   >
                                            <WrapPanel Width="25" Height="25">
                                                <Image Name="imgbtnAdjuntar"   Width="25" Height="25" Source="/WPF_Vehitanques;component/Iconos/document_search.png" ToolTip="Ver Documentos Adjuntos"></Image>
                                            </WrapPanel>
                                        </Button>
                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn   IsReadOnly="True"  ClipboardContentBinding="{Binding}" MinWidth="30" CanUserResize="False" Width="auto" >
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Editar"></Label>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel Orientation="Horizontal"  HorizontalAlignment="Center" >
                                        <Button Name="btn_Editar"  CommandParameter="{Binding Path=CurC_Id}"   FontFamily="Arial" FontWeight="Bold" Click="btn_Editar_Click"   >
                                            <WrapPanel Width="25" Height="25">
                                                <Image Name="imgbtnverDatos"   Width="25" Height="25" Source="/WPF_Vehitanques;component/Iconos/edit.png" ToolTip="Editar datos Curso"></Image>
                                            </WrapPanel>
                                        </Button>
                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn   IsReadOnly="True" ClipboardContentBinding="{Binding}" MinWidth="30" CanUserResize="False" Width="auto" >
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Eliminar"></Label>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel Orientation="Horizontal"  HorizontalAlignment="Center" >
                                        <Button Name="btn_Eliminar"  CommandParameter="{Binding Path=CurC_Id}"   FontFamily="Arial" FontWeight="Bold" Click="btn_Eliminar_Click"    >
                                            <WrapPanel Width="25" Height="25">
                                                <Image Name="imgbtnverDatos"   Width="25" Height="25" Source="/WPF_Vehitanques;component/Iconos/emaildelete.png" ToolTip="Eliminar datos Curso"></Image>
                                            </WrapPanel>
                                        </Button>
                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn   Binding="{Binding Path=IdNotificacion}"  Width="auto" IsReadOnly="true"  Visibility="Hidden"   >
                            <DataGridTextColumn.HeaderTemplate >
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Id Notificación"></Label>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn  Binding="{Binding Path=Descripcion}" Width="auto" IsReadOnly="True" >
                            <DataGridTextColumn.HeaderTemplate >
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Curso"></Label>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment"
                                                    Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn  Binding="{Binding Path=FechaCurso , StringFormat={}{0:dd/MM/yyyy}}"  Width="auto" IsReadOnly="True"  >
                            <DataGridTextColumn.HeaderTemplate >
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Fecha Curso"></Label>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment"
                                    Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn  Binding="{Binding Path=FechaRegistro , StringFormat={}{0:dd/MM/yyyy}}"  Width="auto" IsReadOnly="True"  >
                            <DataGridTextColumn.HeaderTemplate >
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Fecha Registro"></Label>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment"
                                    Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn  Binding="{Binding Path=FechaVigencia , StringFormat={}{0:dd/MM/yyyy}}"  Width="auto" IsReadOnly="True"  >
                            <DataGridTextColumn.HeaderTemplate >
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Fecha Vigencia"></Label>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment"
                                        Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn  Binding="{Binding Path=VigenciaEnMeses}"  Width="auto" IsReadOnly="True" >
                            <DataGridTextColumn.HeaderTemplate >
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Vigencia En Meses"></Label>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>                            
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment"
                                    Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>                            
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center"  />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn    Binding="{Binding Path=PendienteDocumento}"   Width="auto" IsReadOnly="true"    >
                            <DataGridTextColumn.HeaderTemplate >
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Estado Documento"></Label>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>                            
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment"
                                    Value="Center" />
                                </Style>                                
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn  Binding="{Binding Path=PCurC_Obligatorio}"   Width="auto" IsReadOnly="True" >
                            <DataGridCheckBoxColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment"
                                    Value="Center" />
                                </Style>
                            </DataGridCheckBoxColumn.HeaderStyle>
                            <DataGridCheckBoxColumn.HeaderTemplate >
                                <DataTemplate>
                                    <Label HorizontalAlignment="Center" Content="Obligatorio"></Label>
                                </DataTemplate>
                            </DataGridCheckBoxColumn.HeaderTemplate>
                        </DataGridCheckBoxColumn>
                    </DataGrid.Columns>
                </DataGrid> 
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
