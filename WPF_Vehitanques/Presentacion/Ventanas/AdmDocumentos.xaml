<Window x:Class="WPF_Vehitanques.Presentacion.Ventanas.AdmDocumentos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administración de Documentos"  
        Width="auto" 
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen" >
    <GroupBox Header="Gestión de Documentos" Width="Auto"   HorizontalContentAlignment="Stretch" Height="auto" >
        <Grid Name="Grid1">
            <Grid.RowDefinitions>
                <RowDefinition  MaxHeight="02"/>
                <RowDefinition  MaxHeight="50"/>
                <RowDefinition  MaxHeight="50"/>
                <RowDefinition  Height="8*"/>
                <RowDefinition Height="100" ></RowDefinition>
                <RowDefinition Height="10" ></RowDefinition>

                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="20*"/>
                <ColumnDefinition Width="20*"/>
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="35*"/>
            </Grid.ColumnDefinitions>
            <Button Height="40" VerticalAlignment="Bottom"  Grid.Row="1" Grid.Column="4"  HorizontalAlignment="Right" 
                                Width="40" Name="Btn_close"  Click="Btn_close_Click">
                <Image Source="/WPF_Vehitanques;component/Imagenes/salir.jpg" Stretch="Fill" Name="cerrarventana" ToolTip="Cerrar Ventana"></Image>
            </Button>
            <Button Content="Cargar Documentos" Height="25" HorizontalAlignment="Left" Grid.Row=" 1" Grid.Column=" 3"  Name="btn_CargarDoc" VerticalAlignment="Top" Width="150" FontWeight="Bold" FontFamily="Arial"  Click="btn_CargarDoc_Click"  IsEnabled="False" />
            <Button Content="EXAMINAR" Height="25" HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column=" 2"   Name="btn_Examinar2" VerticalAlignment="Top" Width="199" FontFamily="Arial" FontWeight="Bold" Click="btn_Examinar2_Click" />
            <!--<ComboBox Height="23" HorizontalAlignment="Left" Grid.Row=" 2" Grid.Column=" 2"   Name="cbbTipodoc" VerticalAlignment="Top" Width="199" />-->
            <!--<Label Content="Tipo De Documento" Name="lbltipoDoc" Height="28" HorizontalAlignment="Right" Grid.Row=" 2" Grid.Column=" 1"    VerticalAlignment="Top" FontWeight="Bold" FontFamily="Arial" />-->
            <ScrollViewer  Name="ScrollViewer1"  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" >
                <ScrollViewer.Content>
                    <StackPanel Orientation="Vertical" Height="auto" Name="WrapPanel1" Width="auto" >
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="8*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>
                            <WrapPanel Name="wp_Imagenes" Grid.Row="0"/>
                            <!--<Button Height="40" VerticalAlignment="Bottom" Grid.RowSpan="2" HorizontalAlignment="Right" 
                                Width="40" Name="Button1">
                                <Image Source="/Iconos/iconphoto.png" Stretch="Fill" ></Image>
                            </Button>-->

                        </Grid>
                        <WrapPanel Name="wp_Doc" />
                        <WrapPanel Name="wp_Excel" />
                        <WrapPanel Name="wp_PDF" />

                    </StackPanel>
                </ScrollViewer.Content>
            </ScrollViewer>
            <Grid Grid.Row="4" Grid.ColumnSpan="4" Name="detalles"  >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"></ColumnDefinition>
                    <ColumnDefinition Width="10*"></ColumnDefinition>
                    <ColumnDefinition Width="20*"></ColumnDefinition>
                    <ColumnDefinition Width="20*"></ColumnDefinition>
                    <ColumnDefinition Width="20*"></ColumnDefinition>
                    <ColumnDefinition Width="20*"></ColumnDefinition>
                    <ColumnDefinition Width="5*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"></RowDefinition>
                    <RowDefinition Height="35"></RowDefinition>
                    <RowDefinition Height="35"></RowDefinition>
                    <RowDefinition Height="35"></RowDefinition>
                </Grid.RowDefinitions>
                <Label Height="28" Grid.Column="2" Grid.Row="0" Name="Label1" 
               VerticalAlignment="Top" Content="{Binding Path=Nombre}" FontSize="10" />
                <Label Content="{Binding Path=Peso}" 
               Height="28" Grid.Column="1" Grid.Row="3"  Name="Label2" VerticalAlignment="Top" FontSize="10" />
                <Label Content="Nombre:" Grid.Column="1"  Grid.Row="0"  Height="28" HorizontalAlignment="Left"   VerticalAlignment="Top" Width="50" FontSize="10" />
                <Label  Grid.Column="2" Grid.Row="0" Grid.ColumnSpan="3"  Height="28" HorizontalAlignment="Left"  Name="labelNombre" VerticalAlignment="Top" Width="auto" FontSize="10" />
                <Label Content="Tamaño:" Grid.Column="1" Grid.Row="1"  Height="28" HorizontalAlignment="Left"  VerticalAlignment="Top"  Width="50" FontSize="10" />
                <Label  Grid.Column="2" Grid.Row="1"  Height="28" HorizontalAlignment="Left" Name="LabelTamanio" VerticalAlignment="Top"  Width="auto"  FontSize="10" />
                <Label Content="Tipo:" Grid.Column="1" Grid.Row="2"  Height="28" HorizontalAlignment="Left"   VerticalAlignment="Top"  Width="50" FontSize="10" />
                <Label  Grid.Column="2" Grid.Row="2"  Height="28" HorizontalAlignment="Left"  Name="Labeltipo" VerticalAlignment="Top"  Width="auto"  FontSize="10" />
                <Label Content="{Binding Path=tipo}" Height="28"  Name="Label6" VerticalAlignment="Top" FontSize="10" />
                <Image Name="Image1" Grid.Column="5" Grid.Row="1" Grid.RowSpan="2"  Stretch="Fill" Source="{Binding Path=Path}" Height="78" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="89" />
                <Grid.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFDEDEED" Offset="0.071" />
                        <GradientStop Color="#FF00010B" Offset="1" />
                        <GradientStop Color="#FF84849F" Offset="0.381" />
                        <GradientStop Color="#FE595C7E" Offset="0.732" />
                    </LinearGradientBrush>
                </Grid.Background>
            </Grid>

        </Grid>
    </GroupBox>
</Window>
