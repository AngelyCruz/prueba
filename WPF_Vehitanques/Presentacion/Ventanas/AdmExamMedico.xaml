<Window x:Class="WPF_Vehitanques.Presentacion.Ventanas.AdmExamMedico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="administrador Exámenes Nédicos Conductor" 
        Name="admExamMedico"
        Loaded="admExamMedico_Loaded"
        Closed="admExamMedico_Closed"
        WindowStartupLocation="CenterScreen" >
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"  Height="auto"  MinWidth="400" MaxWidth="700">
        <StackPanel Height="auto"   MinWidth="500" MaxWidth="800">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"  ></ColumnDefinition>
                    <ColumnDefinition MinWidth="250" MaxWidth="260" ></ColumnDefinition>
                    <ColumnDefinition MinWidth="300" MaxWidth="400" ></ColumnDefinition>
                    <ColumnDefinition Width="30"></ColumnDefinition>
                   
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="30" MaxHeight="40"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="40"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="40"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="40"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="40"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="40"></RowDefinition>
                    <RowDefinition MinHeight="30" MaxHeight="40"></RowDefinition>

                </Grid.RowDefinitions>
                <Label  Grid.Column="1" Grid.Row="1" Content="* Número" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border IsEnabled="False"  Grid.Column="2" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <TextBox  Name="txtNumdocumento"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="12" VerticalContentAlignment="Center" FontSize="13"  />
                </Border>
                
                <Label  Grid.Column="1" Grid.Row="2" Content="* Nombre(s)" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border IsEnabled="False"  Grid.Column="2"   Grid.Row="2" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <TextBox  Name="txtnombres"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="60" VerticalContentAlignment="Center" FontSize="13"     CharacterCasing="Upper" />
                </Border>

                <Label  Grid.Column="1" Grid.Row="3" Content="* Fecha Vence Examen" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border  Grid.Column="2" Grid.Row="3" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <DatePicker Name="dtfechaexamen" Background="Transparent" BorderThickness="0"  Height="25"  VerticalContentAlignment="Center"  FontSize="13"  CalendarClosed="dtfechaexamen_CalendarClosed"  >
                        <DatePicker.Resources>
                            <Style TargetType="DatePickerTextBox">
                                <Setter Property="IsReadOnly" Value="True"/>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>
                </Border>

                <Label  Grid.Column="1" Grid.Row="4" Content="* DOCUMENTO EXAMENES MÉDICOS" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <WrapPanel Grid.Column="2" Grid.Row="4" Orientation="Horizontal"  HorizontalAlignment="Center"   >
                    <Button    Name="btn_Examenes"  FontFamily="Arial" FontWeight="Bold"  Click="btn_Examenes_Click">
                        <WrapPanel Width="30" Height="30">
                            <Image   Width="30" Height="30" Source="/WPF_Vehitanques;component/Iconos/contract.png"  ToolTip="Ver Documento Examenes Médicos"></Image>
                        </WrapPanel>
                    </Button>
                </WrapPanel>

                <Button Content="GUARDAR" ToolTip=" Guardar Examen médico " FontFamily="Arial" FontSize="15" FontWeight="Bold" Height="23"  HorizontalAlignment="Center"   Name="btn_guardar"   Width="110"  Grid.Column="1"   Grid.Row="15" Grid.ColumnSpan="4"  VerticalAlignment="Center" Click="btn_guardar_Click" />

            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
