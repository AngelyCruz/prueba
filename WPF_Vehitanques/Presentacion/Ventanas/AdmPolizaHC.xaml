<Window x:Class="WPF_Vehitanques.Presentacion.Ventanas.AdmPolizaHC"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Información Histórica de Pólizas de Hidrocarburos"  
        Height="500" Width="800"  MaxWidth="900" MaxHeight="700" 
        IsManipulationEnabled="False"  
        ResizeMode="CanResize" 
        WindowStartupLocation="CenterScreen" 
        Loaded="Window_Loaded" 
        Closed="Window_Closed" >
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"  ></ColumnDefinition>
            <ColumnDefinition Width="25*" ></ColumnDefinition>
            <ColumnDefinition Width="20*"  ></ColumnDefinition>
            <ColumnDefinition Width="5*"></ColumnDefinition>
            <ColumnDefinition Width="20*"></ColumnDefinition>
            <ColumnDefinition Width="20*"></ColumnDefinition>
            <ColumnDefinition Width="5*"  ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>            
            <RowDefinition MinHeight="120" MaxHeight="500"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="120" MaxHeight="500"></RowDefinition>            
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Center"  >
            <Label   VerticalAlignment="Center"   FontWeight="Bold"  Height="25" Content="Seleccione  Como Asociará La Póliza"></Label>
            <RadioButton Name="rdio_vehiculo" Content=" Vehículo   " VerticalAlignment="Center" ></RadioButton>
            <RadioButton Name="rdio_remolque" Content=" Remolque   " VerticalAlignment="Center" ></RadioButton>
            <Label Name="lblerror_checkbox"   VerticalAlignment="Center"  Foreground="Red"   FontWeight="Bold" Width="40" Height="25"></Label>
        </StackPanel>
        
        <Label  Grid.Column="1" Grid.Row="1" Content="* Placa" Height="30" FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="2" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25" >
            <TextBox   Name="txtplaca"  CharacterCasing="Upper"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="6" VerticalContentAlignment="Center" FontSize="13"  TabIndex="1"    IsEnabled="False"   />
        </Border>
        <Label  Grid.Column="4" Grid.Row="1" Content="* Placa Remolque" Height="30" FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="5" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25" >
            <TextBox   Name="txtplacaremolque"  CharacterCasing="Upper"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="6" VerticalContentAlignment="Center" FontSize="13"  TabIndex="1"    IsEnabled="False"   />
        </Border>
        <Label  Grid.Column="4" Grid.Row="3" Content="N° Póliza" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="5" Grid.Row="3" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
            <TextBox  CharacterCasing="Upper"   Name="txtnumpoliza"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="30" VerticalContentAlignment="Center" FontSize="13"    TabIndex="29" PreviewKeyDown="txtnumpoliza_PreviewKeyDown" />
        </Border>
        <Label Name="lblerror_poliza"  Grid.Column="6" Grid.Row="3" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
        <Label  Grid.Column="1" Grid.Row="3" Content="Aseguradora" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="2" Grid.Row="3" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
            <ComboBox Name="cbbciaseguradora" Background="Transparent" BorderThickness="0"  Height="25" VerticalContentAlignment="Center" FontSize="13"  TabIndex="28" />
        </Border>
        <Label Name="lblerror_aseguradora"  Grid.Column="3" Grid.Row="3" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
        <Label  Grid.Column="1" Grid.Row="2" Content="Fecha inicial" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="2" Grid.Row="2" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
            <DatePicker Name="dtfechainicial" Background="Transparent" BorderThickness="0"  Height="25"  VerticalContentAlignment="Center"  FontSize="13"   TabIndex="30" CalendarClosed="dtfechainicial_CalendarClosed">
                <DatePicker.Resources>
                    <Style TargetType="DatePickerTextBox">
                        <Setter Property="IsReadOnly" Value="True"/>
                    </Style>
                </DatePicker.Resources>
            </DatePicker>
        </Border>
        <Label Name="lblerror_fechaini"  Grid.Column="3" Grid.Row="2" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
        
        <Label  Grid.Column="4" Grid.Row="2" Content="Fecha Final" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="5" Grid.Row="2" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
            <DatePicker Name="dtfechafinal" Background="Transparent" BorderThickness="0"  Height="25"  VerticalContentAlignment="Center"  FontSize="13"   TabIndex="30" CalendarClosed="dtfechafinal_CalendarClosed">
                <DatePicker.Resources>
                    <Style TargetType="DatePickerTextBox">
                        <Setter Property="IsReadOnly" Value="True"/>
                    </Style>
                </DatePicker.Resources>
            </DatePicker>
        </Border>
        <Label Name="lblerror_fechafinal"  Grid.Column="6" Grid.Row="2" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>

        <Label  Grid.Column="1" Grid.Row="4" Content="Póliza de Hidrocarburos" Height="30"  FontSize="13"  VerticalAlignment="Center"   />

        <WrapPanel Grid.Column="2" Grid.Row="4" Orientation="Horizontal"  HorizontalAlignment="Left"  >
            <Button  Name="btn_poliza"   FontFamily="Arial" FontWeight="Bold" TabIndex="23" Click="btn_poliza_Click">
                <WrapPanel Width="50" Height="25">
                    <Image   Width="50" Height="25" Source="/WPF_Vehitanques;component/Iconos/document_search.png"  ToolTip="Ver Documento Póliza de Hidrocarburos"></Image>
                </WrapPanel>
            </Button>
        </WrapPanel>

        <Button Content="Aceptar" FontFamily="Arial" FontSize="15" FontWeight="Bold" Height="23"  HorizontalAlignment="Center"   Name="btn_aceptar"   Width="75"  Grid.Column="4"  Grid.Row="4"   VerticalAlignment="Center" Click="btn_aceptar_Click"  ToolTip="Guardar los cambios" />
        <Button Content="Cancelar" FontFamily="Arial" FontSize="15" FontWeight="Bold" Height="23"  HorizontalAlignment="Center"   Name="btn_cancelar"   Width="75"  Grid.Column="5"  Grid.Row="4"   VerticalAlignment="Center" Click="btn_cancelar_Click"  ToolTip="Cancelar los cambios" />
        <StackPanel Name="pnl_Paginacion" Orientation="Horizontal" HorizontalAlignment="Center"  VerticalAlignment="Bottom"   MaxHeight="30" Grid.Row="5" Grid.Column="0 " Grid.ColumnSpan="8">
            <Button Margin="4,0" Content="Ant." Name="btn_ant" IsEnabled=" false" MinHeight="22" MinWidth="35" TabIndex="3" Click="btn_ant_Click"  />
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="Mostrando registros del " Foreground="Black" />
                <TextBlock Name ="lbl_Inicio" Text="" Foreground="Black" />
                <TextBlock Text=" al " Foreground="Black" />
                <TextBlock Name ="lbl_Fin" Text="" Foreground="Black"/>
                <TextBlock Text=" de " Foreground="Black" />
                <TextBlock Name ="lbl_Total" Text="" Foreground="Black"/>
            </StackPanel>
            <Button Name="btn_sig" Margin="4,0" Content="Sig." MinHeight="22" MinWidth="35" TabIndex="4" Click="btn_sig_Click" />
        </StackPanel >


        <DataGrid  Name="gridlistadovehiculos"  Width="auto"  CopyingRowClipboardContent="gridlistadovehiculos_CopyingRowClipboardContent"  CanUserReorderColumns="False" FontWeight="Bold" FontFamily="Arial"  CanUserAddRows="False" CanUserResizeRows="False"  CanUserResizeColumns="True" AlternatingRowBackground="#BCF9FA"  AutoGenerateColumns="False" Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="8"  ColumnWidth="Auto" HorizontalContentAlignment="Center" Cursor="Hand" MaxHeight="500"  HorizontalAlignment="Center"  VerticalAlignment="Stretch"  CanUserDeleteRows="False" IsEnabled="True" Visibility="Visible"  >
            <DataGrid.Columns >
                <DataGridTemplateColumn  ClipboardContentBinding="{Binding}" MinWidth="50" CanUserResize="False" Width="auto" >
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Label HorizontalAlignment="Center" Content="Eliminar"></Label>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment"
                                            Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <WrapPanel Orientation="Horizontal"  HorizontalAlignment="Center" >
                                <Button Name="btndelpolizavehi"  CommandParameter="{Binding Path=IdTipoCobro}"   FontFamily="Arial" FontWeight="Bold" Click="btndelpolizavehi_Click"  >
                                    <WrapPanel Width="25" Height="25">
                                        <Image    Width="25" Height="25" Source="/WPF_Vehitanques;component/Iconos/delete.png" ToolTip="Eliminar la póliza de hidrocarburos"></Image>
                                    </WrapPanel>
                                </Button>
                            </WrapPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ver" ClipboardContentBinding="{Binding}" MinWidth="30" CanUserResize="False" Width="auto" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <WrapPanel Orientation="Horizontal"  HorizontalAlignment="Center" >
                                <Button Name="btnverDatos"  CommandParameter="{Binding Path=Poliza}"   FontFamily="Arial" FontWeight="Bold" Click="btnverDatos_Click"  >
                                    <WrapPanel Width="25" Height="25">
                                        <Image Name="imgbtnverDatos"   Width="25" Height="25" Source="/WPF_Vehitanques;component/Imagenes/Buscar.jpg" ToolTip="Ver Datos de la póliza"></Image>
                                    </WrapPanel>
                                </Button>
                            </WrapPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Placa" Binding="{Binding Path=Placa}"  MaxWidth="80" MinWidth="60" IsReadOnly="true"   />
                <DataGridTextColumn Header="N° Póliza" Binding="{Binding Path=Poliza}" Width="auto" IsReadOnly="True" />
                <DataGridTextColumn Header="ID Aseguradora"  Binding="{Binding Path=Aseguradora}"   Width="auto" IsReadOnly="True" />
                <DataGridTextColumn Header="Aseguradora" Binding="{Binding Path=Nombre}"   Width="auto" IsReadOnly="True" />
                <DataGridTextColumn Header="Fecha Inicial" Binding="{Binding Path=Fechainicial, StringFormat={}{0:dd/MM/yyyy}}"   Width="auto" IsReadOnly="True" />
                <DataGridTextColumn Header="Fecha Final" Binding="{Binding Path=Fechafinal , StringFormat={}{0:dd/MM/yyyy}}"  Width="auto" IsReadOnly="True" />                
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Name="pnl_Paginacion1" Orientation="Horizontal" HorizontalAlignment="Center"  VerticalAlignment="Bottom"   MaxHeight="30" Grid.Row="7" Grid.Column="0 " Grid.ColumnSpan="8">
            <Button Margin="4,0" Content="Ant." Name="btn_ant1" IsEnabled=" false" MinHeight="22" MinWidth="35" TabIndex="3" Click="btn_ant1_Click"  />
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="Mostrando registros del " Foreground="Black" />
                <TextBlock Name ="lbl_Inicio1" Text="" Foreground="Black" />
                <TextBlock Text=" al " Foreground="Black" />
                <TextBlock Name ="lbl_Fin1" Text="" Foreground="Black"/>
                <TextBlock Text=" de " Foreground="Black" />
                <TextBlock Name ="lbl_Total1" Text="" Foreground="Black"/>
            </StackPanel>
            <Button Name="btn_sig1" Margin="4,0" Content="Sig." MinHeight="22" MinWidth="35" TabIndex="4" Click="btn_sig1_Click" />
        </StackPanel >


        <DataGrid  Name="gridlistadoremolque"  Width="auto"  CopyingRowClipboardContent="gridlistadoremolque_CopyingRowClipboardContent"  CanUserReorderColumns="False" FontWeight="Bold" FontFamily="Arial"  CanUserAddRows="False" CanUserResizeRows="False"  CanUserResizeColumns="True" AlternatingRowBackground="#BCF9FA"  AutoGenerateColumns="False" Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="8"  ColumnWidth="Auto" HorizontalContentAlignment="Center" Cursor="Hand" MaxHeight="500"  HorizontalAlignment="Center"  VerticalAlignment="Stretch"  CanUserDeleteRows="False" IsEnabled="True" Visibility="Visible"  >
            <DataGrid.Columns >
                <DataGridTemplateColumn  ClipboardContentBinding="{Binding}" MinWidth="50" CanUserResize="False" Width="auto" >
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Label HorizontalAlignment="Center" Content="Eliminar"></Label>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment"
                                            Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <WrapPanel Orientation="Horizontal"  HorizontalAlignment="Center" >
                                <Button Name="btndelpolizaremol"  CommandParameter="{Binding Path=IdTipoCobro}"   FontFamily="Arial" FontWeight="Bold" Click="btndelpolizaremol_Click"  >
                                    <WrapPanel Width="25" Height="25">
                                        <Image    Width="25" Height="25" Source="/WPF_Vehitanques;component/Iconos/delete.png" ToolTip="Eliminar la póliza de hidrocarburos"></Image>
                                    </WrapPanel>
                                </Button>
                            </WrapPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ver" ClipboardContentBinding="{Binding}" MinWidth="30" CanUserResize="False" Width="auto" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <WrapPanel Orientation="Horizontal"  HorizontalAlignment="Center" >
                                <Button Name="btnverDatos"  CommandParameter="{Binding Path=Poliza}"   FontFamily="Arial" FontWeight="Bold" Click="btnverDatosremolque_Click"  >
                                    <WrapPanel Width="25" Height="25">
                                        <Image Name="imgbtnverDatos"   Width="25" Height="25" Source="/WPF_Vehitanques;component/Imagenes/Buscar.jpg" ToolTip="Ver Datos de la póliza"></Image>
                                    </WrapPanel>
                                </Button>
                            </WrapPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Placa" Binding="{Binding Path=Placa}"  MaxWidth="80" MinWidth="60" IsReadOnly="true"   />
                <DataGridTextColumn Header="N° Póliza" Binding="{Binding Path=Poliza}" Width="auto" IsReadOnly="True" />
                <DataGridTextColumn Header="ID Aseguradora"  Binding="{Binding Path=Aseguradora}"   Width="auto" IsReadOnly="True" />
                <DataGridTextColumn Header="Aseguradora" Binding="{Binding Path=Nombre}"   Width="auto" IsReadOnly="True" />
                <DataGridTextColumn Header="Fecha Inicial" Binding="{Binding Path=Fechainicial, StringFormat={}{0:dd/MM/yyyy}}"   Width="auto" IsReadOnly="True" />
                <DataGridTextColumn Header="Fecha Final" Binding="{Binding Path=Fechafinal , StringFormat={}{0:dd/MM/yyyy}}"  Width="auto" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>


    </Grid>
    
</Window>
