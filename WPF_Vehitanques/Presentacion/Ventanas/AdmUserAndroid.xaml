<Window x:Class="WPF_Vehitanques.Presentacion.Ventanas.AdmUserAndroid"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrador Usuarios Android" 
        Height="400" Width="auto" 
        Loaded="Window_Loaded" 
        WindowState="Normal" 
        WindowStartupLocation="CenterScreen" >
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"  Height="auto">
        <StackPanel Height="auto" >
            <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"  ></ColumnDefinition>
            <ColumnDefinition Width="20*" ></ColumnDefinition>
            <ColumnDefinition Width="20*" ></ColumnDefinition>
            <ColumnDefinition Width="5*"></ColumnDefinition>
            <ColumnDefinition Width="5*"></ColumnDefinition>
            <ColumnDefinition Width="20*" ></ColumnDefinition>
            <ColumnDefinition Width="20*" ></ColumnDefinition>
            <ColumnDefinition Width="5*"></ColumnDefinition>
            <ColumnDefinition Width="5*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
            <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
            <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
            <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
            <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
            <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
            <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
            <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
            <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
                    <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
            <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>
            <RowDefinition MinHeight="20" MaxHeight="30"></RowDefinition>  
                </Grid.RowDefinitions>


                <Label  Grid.Column="1" Grid.Row="1" Content="Tipo Doc." Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border Grid.Column="2" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <ComboBox  IsEnabled="False"  Name="cbbtipodocumento" Background="Transparent" BorderThickness="0"  Height="25" VerticalContentAlignment="Center" FontSize="13"  TabIndex="1"/>
                </Border>
                <Label  Grid.Column="5" Grid.Row="1" Content="* Número" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border Grid.Column="6" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <TextBox  Name="txtNumdocumento"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="12" VerticalContentAlignment="Center" FontSize="13"    TabIndex="2" IsEnabled="False" />
                </Border>
                <Label Name="lblerror_documenConductor"  Grid.Column="7" Grid.Row="1" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
               
                
                <Label  Grid.Column="1" Grid.Row="2" Content="* Nombre(s)" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border Grid.Column="2"  Grid.ColumnSpan="5" Grid.Row="2" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <TextBox  IsEnabled="False"  Name="txtnombres"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="60" VerticalContentAlignment="Center" FontSize="13"      CharacterCasing="Upper" TabIndex="3"/>
                </Border>
                <Label Name="lblerror_nombresCond"  Grid.Column="7" Grid.Row="2" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
                <Label  Grid.Column="1" Grid.Row="3" Content="* 1er Apellido" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border Grid.Column="2" Grid.Row="3" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <TextBox IsEnabled="False"   Name="txtapellido1"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="50" VerticalContentAlignment="Center" FontSize="13"    CharacterCasing="Upper"  TabIndex="4" />
                </Border>
                <Label Name="lblerror_apellido1Cond"  Grid.Column="3" Grid.Row="3" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
                <Label  Grid.Column="5" Grid.Row="3" Content="* 2do Apellido" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border Grid.Column="6" Grid.Row="3" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <TextBox IsEnabled="False"   Name="txtapellido2"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="50" VerticalContentAlignment="Center" FontSize="13"   CharacterCasing="Upper"  TabIndex="5"/>
                </Border>
                <Label Name="lblerror_apellido2Cond"  Grid.Column="7" Grid.Row="3" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
                <Label  Grid.Column="1" Grid.Row="4" Content="Operación Empresa" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border Grid.Column="2" Grid.Row="4" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <ComboBox    Name="cbboperacion" Background="Transparent" BorderThickness="0"  Height="25" VerticalContentAlignment="Center" FontSize="13"  TabIndex="1"/>
                </Border>
                <Label  Grid.Column="5" Grid.Row="4" Content="Estado" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border Grid.Column="6" Grid.Row="4" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <ComboBox    Name="cbbestado" Background="Transparent" BorderThickness="0"  Height="25" VerticalContentAlignment="Center" FontSize="13"  TabIndex="1"/>
                </Border>
                <Label  Grid.Column="1" Grid.Row="5" Content="* Id Usuario Android" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border Grid.Column="2" Grid.Row="5" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <TextBox IsEnabled="False"   Name="txtusername"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="50" VerticalContentAlignment="Center" FontSize="13"     CharacterCasing="Upper"  TabIndex="4" />
                </Border>
                <Label Name="lblerror_username"  Grid.Column="3" Grid.Row="5" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
                <Label  Grid.Column="5" Grid.Row="5" Content="* Contraseña Android" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <Border Grid.Column="6" Grid.Row="5" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
                    <TextBox   Name="txtclave"  IsEnabled="False"  Background="Transparent" BorderThickness="0"  Height="25" MaxLength="50" VerticalContentAlignment="Center" FontSize="13"  CharacterCasing="Upper"  TabIndex="5"/>
                </Border>                
                <Label Name="lblerror_txtclave"  Grid.Column="7" Grid.Row="5" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
                <CheckBox   Grid.Column="6" Grid.Row="6" Name="chkmodificaclave" Content="Modificar Clave" VerticalAlignment="Center"   Checked="chkmodificaclave_Checked"  Unchecked="chkmodificaclave_Unchecked"></CheckBox>


                <Button Content=" GUARDAR " ToolTip= "Guardar " FontFamily="Arial" FontSize="15" FontWeight="Bold" Height="23"  HorizontalAlignment="Center"   Name="btn_guardar"   Width="110"  Grid.Column="2"  Grid.Row="7" Grid.ColumnSpan="4"  VerticalAlignment="Center" Click="btn_guardar_Click" TabIndex="24"/>
                <Button Content=" Generar Clave " ToolTip= "Guardar " FontFamily="Arial" FontSize="15" FontWeight="Bold" Height="23"  HorizontalAlignment="Center"   Name="btn_generarclave"   Width="140"  Grid.Column="6"  Grid.Row="7"   VerticalAlignment="Center" Click="btn_generarclave_Click"  IsEnabled="False" />
                <!--<Label  Grid.Column="1" Grid.Row="9" Content="Notificaciones de usuario" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
                <WrapPanel   Grid.Column="2" Grid.Row="9" Orientation="Horizontal"  HorizontalAlignment="Left" >
                    <Button  Name="btn_MailAndroid"   FontFamily="Arial" FontWeight="Bold"  Click="btn_MailAndroid_Click" IsEnabled="False" >
                        <WrapPanel Width="50" Height="40">
                            <Image   Width="50" Height="40" Source="/WPF_Vehitanques;component/Iconos/Mail_icon.png" ToolTip="Agregar Notificación de usuario" ></Image>
                        </WrapPanel>
                    </Button>
                </WrapPanel>-->
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
