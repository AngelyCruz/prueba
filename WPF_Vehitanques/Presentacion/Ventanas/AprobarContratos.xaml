<Window x:Class="WPF_Vehitanques.Presentacion.Ventanas.AprobarContratos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="Aprobación de Contratos" 
        Height="300" Width="320"  
        IsManipulationEnabled="False"  
        ResizeMode="NoResize"  
        WindowStartupLocation="CenterScreen"  >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" MaxWidth="180"></ColumnDefinition>
            <ColumnDefinition Width="150" MaxWidth="180"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" MaxHeight="50"></RowDefinition>
            <RowDefinition Height="30" MaxHeight="50"></RowDefinition>
            <RowDefinition Height="30" MaxHeight="50"></RowDefinition>
            <RowDefinition Height="30" MaxHeight="50"></RowDefinition>
            <RowDefinition Height="30" MaxHeight="50"></RowDefinition>
            <RowDefinition Height="50" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="30" MaxHeight="50"></RowDefinition>

        </Grid.RowDefinitions>

        <Label  Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"  Height="30" FontSize="17" HorizontalAlignment="Center"   VerticalAlignment="Center" Name="lbluser" Content="user" FontWeight="Bold"  />
        <Label  Grid.Column="0" Grid.Row="1" Content="Placa" Height="30" FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="1" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25" >
            <TextBox   Name="txtplaca"  CharacterCasing="Upper"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="6" VerticalContentAlignment="Center" FontSize="13"  TabIndex="1"      IsEnabled="False" />
        </Border>
        <Label  Grid.Column="0" Grid.Row="2" Content="Documento Conductor" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="1" Grid.Row="2" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
            <TextBox  Name="txtNumdocumento"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="12" VerticalContentAlignment="Center" FontSize="13"    TabIndex="2" IsEnabled="False" />
        </Border>
        <Label  Grid.Column="0" Grid.Row="3" Content="Número de Contrato" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="1" Grid.Row="3" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
            <TextBox  Name="txtNumcontrato"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="12" VerticalContentAlignment="Center" FontSize="13"    TabIndex="2" IsEnabled="False" />
        </Border>
        <Label  Grid.Column="0" Grid.Row="4" Content="Usuario Creador" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="1" Grid.Row="4" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
            <TextBox  Name="txtusuarioCreador"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="12" VerticalContentAlignment="Center" FontSize="13"    TabIndex="2" IsEnabled="False" />
        </Border>

        <WrapPanel Grid.Column="0" Grid.Row="5" Orientation="Horizontal"  HorizontalAlignment="Center"  >
            <Button   Name="btn_Aprobar"   FontFamily="Arial" FontWeight="Bold" TabIndex="6" Click="btn_Aprobar_Click">
                <WrapPanel Width="40" Height="40">
                    <Image  Width="40" Height="40" Source="/WPF_Vehitanques;component/Iconos/stop1normal.png"  ToolTip=" Aprobar El Contrato COLTANQUES" ></Image>
                </WrapPanel>
            </Button>
        </WrapPanel>
        <WrapPanel Grid.Column="1" Grid.Row="5" Orientation="Horizontal"  HorizontalAlignment="Center"  >
            <Button   Name="btn_Noaprobar"   FontFamily="Arial" FontWeight="Bold" TabIndex="7"  Click="btn_Noaprobar_Click" >
                <WrapPanel Width="40" Height="40">
                    <Image   Width="40" Height="40" Source="/WPF_Vehitanques;component/Iconos/stop1normalred.png"  ToolTip="No Aprobar El Contrato COLTANQUES" ></Image>
                </WrapPanel>
            </Button>
        </WrapPanel>
    </Grid>
</Window>
