<Window x:Class="WPF_Vehitanques.Presentacion.Ventanas.CambiarEstadoVehiculo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       Title="Cambiar Estado al Vehículo" 
        Height="500" Width="400"   MaxWidth="400" MaxHeight="500" 
        IsManipulationEnabled="False"  
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" >

    <Grid  >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"  ></ColumnDefinition>
            <ColumnDefinition Width="20*" ></ColumnDefinition>
            <ColumnDefinition Width="20*" ></ColumnDefinition>
            <ColumnDefinition Width="15*" ></ColumnDefinition>
            <ColumnDefinition Width="20*" ></ColumnDefinition>
            <ColumnDefinition Width="25*" ></ColumnDefinition>
            <ColumnDefinition Width="5*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>

        <Label  Grid.Column="2" Grid.Row="1" FontWeight="Bold" Content="Placa: " VerticalAlignment="Center" HorizontalAlignment="Right"  FontSize="20"></Label>
        <WrapPanel Grid.Column="3" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.ColumnSpan="2">
            <!--<Border CornerRadius="10" BorderThickness="1" BorderBrush="Black" >-->
            <Button Height="50" Width="100" Foreground="White" FontWeight="Bold"   >

                <Label  Name="lblplaca"    FontSize="15"  HorizontalAlignment="Center" VerticalAlignment="Center" ></Label>
                <Button.Background>
                    <ImageBrush ImageSource="/WPF_Vehitanques;component/Iconos/placas-amarilla.png" />
                </Button.Background>
            </Button>
            <!--</Border>-->
        </WrapPanel>
        <Button Content="Aceptar" FontFamily="Arial" FontSize="15" FontWeight="Bold" Height="23"  HorizontalAlignment="Center" Click="btn_aceptar_Click"   Name="btn_aceptar"   Width="75"  Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="7"  VerticalAlignment="Center"  />
        <Border Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="3" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
            <ComboBox Name="cbbestado" Background="Transparent" BorderThickness="0"  Height="25" VerticalContentAlignment="Center" FontSize="15">

            </ComboBox>
        </Border>
        <Border Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="3"   Grid.RowSpan="5" CornerRadius="5" BorderThickness="1" BorderBrush="Black" MinHeight="100" MaxHeight="150">

            <TextBox   Name="txtobservaciones"  TextWrapping="Wrap"  AcceptsReturn="True"
  VerticalScrollBarVisibility="Visible" MaxHeight="150" MinHeight="150" MaxWidth="400" MaxLength="250" KeyUp="TextboxtStringShift_KeyUp"></TextBox>

        </Border>

        <Label Name="lblerror_observaciones"  Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="8" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="auto" Height="30"></Label>
    </Grid>
</Window>
