<Window x:Class="WPF_Vehitanques.Presentacion.Ventanas.EnvioMsgDeTexto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          Title="Mensajes de texto" 
        Height="380" Width="400" MaxWidth="450" MaxHeight="400" 
        Name="vetanaEnvioMsgDeTexto" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"></ColumnDefinition>
            <ColumnDefinition Width="20*"></ColumnDefinition>
            <ColumnDefinition Width="20*"></ColumnDefinition>
            <ColumnDefinition Width="10*"></ColumnDefinition>
            <ColumnDefinition Width="20*"></ColumnDefinition>
            <ColumnDefinition Width="20*"></ColumnDefinition>
            <ColumnDefinition Width="5*"></ColumnDefinition>

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="180" MaxHeight="200"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition Height="10"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Content="MENSAJES DE TEXTO A CELULAR"  Height="25" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" HorizontalAlignment="Center" FontStretch="SemiCondensed"  ></Label>
        <Button Content="ENVIAR MENSAJE" FontFamily="Arial" FontSize="15" FontWeight="Bold" Height="23"  HorizontalAlignment="Center"   Name="btn_EnviarMsg"   Width="170"  Grid.Column="2" Grid.ColumnSpan="3"  Grid.Row="1"  VerticalAlignment="Center" Click="btn_EnviarMsg_Click"    />
        <Border Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="3"    CornerRadius="5" BorderThickness="1" BorderBrush="Black" MinHeight="100" MaxHeight="150" >
            <TextBox   Name="txtmensajetexto"  TextWrapping="Wrap"  AcceptsReturn="True"
         VerticalScrollBarVisibility="Visible" MaxHeight="150" MinHeight="150" MaxWidth="380" MaxLength="155" MinWidth="300"  PreviewKeyDown="txtmensajetexto_PreviewKeyDown"></TextBox>
        </Border>
        <Label Name="lblerror_mensaje" Grid.Row="4"  Grid.Column="1" Grid.ColumnSpan="5"  HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold"  Height="25"></Label>


    </Grid>
</Window>
