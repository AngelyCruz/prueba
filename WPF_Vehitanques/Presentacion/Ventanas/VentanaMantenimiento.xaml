<Window x:Class="WPF_Vehitanques.Presentacion.Ventanas.VentanaMantenimiento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="Ventana Mantenimiento"
        Height="450" Width="450" 
    
        Background="Black" 
        WindowState="Normal"   
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" 
        HorizontalAlignment="Center"     
        IsManipulationEnabled="False"   
      
        WindowStyle="ToolWindow" 
        Closed="Window_Closed"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="80" MaxHeight="90"></RowDefinition>
            <RowDefinition MinHeight="240" MaxHeight="250"></RowDefinition>
            <RowDefinition MinHeight="45" MaxHeight="60"></RowDefinition>
        </Grid.RowDefinitions>
        <Label  FontFamily="Arial" FontSize="18" FontWeight="Bold" Height="80" MaxHeight="150" HorizontalAlignment="Center"  VerticalAlignment="Center"    BorderBrush="White" FontStretch="Normal" Foreground="Red"  FlowDirection="LeftToRight" Focusable="False" HorizontalContentAlignment="Center" OpacityMask="White"  >

            <TextBlock TextWrapping="WrapWithOverflow"  Name="lblmensaje"  Text="APLICACIÓN EN MANTENIMIENTO- 
                       POR FAVOR ESPERE QUE ESTÉ NUEVAMENTE EN LINEA." TextAlignment="Center"  ></TextBlock>
        </Label>
        <StackPanel Grid.Row="1" Background="DarkGray"   >
            <Image gif:ImageBehavior.RepeatBehavior="Forever" 
               gif:ImageBehavior.AnimatedSource="/Iconos/Gif/Imagen-animada-Construccion.gif"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="300" Height="210" />
        </StackPanel>
   
        <!--<MediaElement Source="/Iconos/Gif/Imagen-animada-Construccion.gif" Grid.Row="1" HorizontalAlignment="Stretch" ></MediaElement>-->
        <Button Grid.Row="2" Content="Aceptar" FontFamily="Arial" FontSize="15" FontWeight="Bold" Height="30"  HorizontalAlignment="Center" Click="btn_ventanamensaje_Click"   Name="btn_ventanamensaje" VerticalAlignment="Bottom"  Width="75"  />
    </Grid>
</Window>
