<Window x:Class="WPF_Vehitanques.Presentacion.Ventanas.VentanaMensaje"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="Ventanamensaje" 
        Height="300"  MinWidth="400" MaxWidth="600"  
        ResizeMode="CanResize"
        WindowState="Normal" 
        WindowStyle="ThreeDBorderWindow" 
        Icon="/WPF_Vehitanques;component/Imagenes/LogoOk.png" 
        HorizontalContentAlignment="Center" >

    <Grid  Height="auto" Width="auto" HorizontalAlignment="Center" >
        <Label  FontFamily="Arial" FontSize="18" FontWeight="Bold" Height="35"  HorizontalAlignment="Center"  Name="lblTitulo" VerticalAlignment="Top" BorderBrush="White" FontStretch="Normal" Foreground="#FF1353EA" Content="TÍTULO" HorizontalContentAlignment="Center" Cursor="Help" />
        <Label  FontFamily="Arial" FontSize="18" FontWeight="Bold" Height="62" MaxHeight="150" HorizontalAlignment="Center"  VerticalAlignment="Center"    BorderBrush="White" FontStretch="Normal" Foreground="#FF1353EA" FlowDirection="LeftToRight" Focusable="False" HorizontalContentAlignment="Center" OpacityMask="White"  >

            <TextBlock TextWrapping="WrapWithOverflow"  Name="lblmensaje"  Text="MENSAJE" TextAlignment="Center" ></TextBlock>
        </Label>
        <Button Content="Aceptar" FontFamily="Arial" FontSize="15" FontWeight="Bold" Height="23"  HorizontalAlignment="Center" Click="btn_ventanamensaje_Click"   Name="btn_ventanamensaje" VerticalAlignment="Bottom"  Width="75"  />

    </Grid>
</Window>
