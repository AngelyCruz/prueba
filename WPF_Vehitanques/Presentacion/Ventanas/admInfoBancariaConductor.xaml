<Window x:Class="WPF_Vehitanques.Presentacion.Ventanas.admInfoBancariaConductor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Información Bancaria Conductor"  
        Height="600" Width="550"  MaxWidth="550" MaxHeight="700" 
        IsManipulationEnabled="False"  
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" 
        Loaded="Window_Loaded">
    <Grid >

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*"  ></ColumnDefinition>
            <ColumnDefinition Width="30*" ></ColumnDefinition>
            <ColumnDefinition Width="40"  ></ColumnDefinition>
            <ColumnDefinition Width="20*"></ColumnDefinition>
            <ColumnDefinition Width="30*"></ColumnDefinition>
            <ColumnDefinition Width="40"  ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="50" MaxHeight="70"></RowDefinition>
            <RowDefinition MinHeight="50" MaxHeight="70"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
            <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
        </Grid.RowDefinitions>
        <Label    Grid.Column="0" Content="Id Conductor" Grid.Row="0"></Label>
        <Label   Name="lblidconductor" Grid.Column="1" Grid.Row="0"  FontWeight="Black"></Label>

        <StackPanel Grid.Column="3" Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" >
            <Label   Content="Id Beneficiario: " Grid.Column="3" Grid.Row="0"></Label>
            <Label   Name="lblidpropietario" Grid.Column="1" Grid.Row="0" FontWeight="Black"></Label>
            <Label   Content="  Digito Veri: " Grid.Column="3" Grid.Row="0"></Label>
            <Label   Name="lbldigVer" Grid.Column="4" Grid.Row="0"  FontWeight="Black"></Label>
        </StackPanel>


        <Label  Grid.Column="0" Grid.Row="2" Content="N° Cuenta" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="1" Grid.Row="2" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25" >
            <TextBox  Name="txtnumcuenta"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="12" VerticalContentAlignment="Center" FontSize="13"   Margin="0,0,0,-2" VerticalAlignment="Bottom"  KeyDown="textboxt_KeyDown"  />
        </Border>
        <Label  Grid.Column="0" Grid.Row="3" Content="NIT Cuenta" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="1" Grid.Row="3" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25" >
            <TextBox  Name="txtnitcuenta"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="12" VerticalContentAlignment="Center" FontSize="13"   Margin="0,0,0,-2" VerticalAlignment="Bottom"  KeyDown="textboxt_KeyDown"  />
        </Border>
        <Label Name="lblerror_numcuenta"  Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>


        <Label  Grid.Column="0" Grid.Row="1" Content="Banco" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="1" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25"  >
            <ComboBox Name="cbbbanco" Background="Transparent" BorderThickness="0"  Height="25" VerticalContentAlignment="Center" FontSize="13" />
        </Border>
        <Label  Grid.Column="3" Grid.Row="1" Content="Tipo cuenta" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="4" Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25"  >
            <ComboBox Name="cbbtipocuenta" Background="Transparent" BorderThickness="0"  Height="25" VerticalContentAlignment="Center" FontSize="13" />
        </Border>
        <Label  Grid.Column="3" Grid.Row="2" Content="Id Tarjeta" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="4" Grid.Row="2" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25"  >
            <TextBox  Name="txtidtarjeta"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="5" VerticalContentAlignment="Center" FontSize="13" KeyDown="textboxt_KeyDown"  />
        </Border>

        <Label Name="lblerror_idtarjeta"  Grid.Column="5" Grid.Row="2" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="40" Height="25"></Label>
        <GroupBox  Grid.Column="0" Grid.ColumnSpan="6" Grid.Row="5"  Grid.RowSpan="2"   Header="Documentos Información Bancaria"  VerticalContentAlignment="Top"  BorderBrush="Blue"   >
            <StackPanel Name="pnl_botonesdocbancarios"  >
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25*"  ></ColumnDefinition>
                        <ColumnDefinition Width="25*"  ></ColumnDefinition>
                        <ColumnDefinition Width="25*"  ></ColumnDefinition>
                        <ColumnDefinition Width="25*"  ></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition MinHeight="30" MaxHeight="40"></RowDefinition>
                        <RowDefinition MinHeight="30" MaxHeight="40"></RowDefinition>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" Orientation="Vertical"   HorizontalAlignment="Center"  VerticalAlignment="Center"  >
                        <TextBlock Text="Documentos Bancarios CONDUCTOR"></TextBlock>
                        <Button   Name="btn_docbancarioscond" Width="45" Height="45"  FontFamily="Arial" FontWeight="Bold"  Click="btn_docbancarioscond_Click">
                            <WrapPanel Width="40" Height="40">
                                <Image   Width="40" Height="40" Source="/WPF_Vehitanques;component/Iconos/Checklist-icon (2).png"  ToolTip="Documentación bancaria obligatoria" ></Image>
                            </WrapPanel>
                        </Button>
                    </WrapPanel>
                    <WrapPanel Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" Orientation="Vertical"   HorizontalAlignment="Center"  VerticalAlignment="Center"  >
                        <TextBlock Text="Documentos Bancarios BENEFICIARIO-PROP"></TextBlock>
                        <Button   Name="btn_docbancariosben" Width="45" Height="45"  FontFamily="Arial" FontWeight="Bold"  Click="btn_docbancariosben_Click">
                            <WrapPanel Width="40" Height="40">
                                <Image   Width="40" Height="40" Source="/WPF_Vehitanques;component/Iconos/Checklist-icon (2).png"  ToolTip="Documentación bancaria obligatoria" ></Image>
                            </WrapPanel>
                        </Button>
                    </WrapPanel>
                    <!--<WrapPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Orientation="Vertical"   HorizontalAlignment="Center"  VerticalAlignment="Center"  >
                        <TextBlock Text="Cédula"></TextBlock>
                        <Button   Name="btn_cedulaconductor1"   FontFamily="Arial" FontWeight="Bold"  Click="btn_cedulaconductor_Click" >
                            <WrapPanel Width="40" Height="40">
                                <Image   Width="40" Height="40" Source="/WPF_Vehitanques;component/Iconos/Student-id.png"  ToolTip="Cédula de Ciudadanía" ></Image>
                            </WrapPanel>
                        </Button>
                    </WrapPanel>
                    <WrapPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Orientation="Vertical"   HorizontalAlignment="Center"  VerticalAlignment="Center"  >
                        <TextBlock Text="Cert. Bancaria"></TextBlock>
                        <Button   Name="btn_certibancaria" Width="45" Height="45"  FontFamily="Arial" FontWeight="Bold"  Click="btn_certibancaria_Click">
                            <WrapPanel Width="40" Height="40">
                                <Image   Width="40" Height="40" Source="/WPF_Vehitanques;component/Iconos/Gnome-application-certificate.png"  ToolTip="Certificación Bancaria" ></Image>
                            </WrapPanel>
                        </Button>
                    </WrapPanel>
                    <WrapPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Orientation="Vertical"   HorizontalAlignment="Center"  VerticalAlignment="Center"  >
                        <TextBlock Text=" RUT "></TextBlock>
                        <Button   Name="btn_rut" Width="45" Height="45"  FontFamily="Arial" FontWeight="Bold"  Click="btn_rut_Click">
                            <WrapPanel Width="40" Height="40">
                                <Image   Width="40" Height="40" Source="/WPF_Vehitanques;component/Iconos/logoDIAN.png"  ToolTip="RUT Dian" ></Image>
                            </WrapPanel>
                        </Button>
                    </WrapPanel>
                    <WrapPanel Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" Orientation="Vertical"   HorizontalAlignment="Center"  VerticalAlignment="Center"  >
                        <TextBlock Text="Formato Creación"></TextBlock>
                        <Button   Name="btn_formatCreacion" Width="45" Height="45"  FontFamily="Arial" FontWeight="Bold"  Click="btn_formatCreacion_Click">
                            <WrapPanel Width="40" Height="40">
                                <Image   Width="40" Height="40" Source="/WPF_Vehitanques;component/Iconos/Checklist-icon (2).png"  ToolTip="Formato de Creación" ></Image>
                            </WrapPanel>
                        </Button>
                    </WrapPanel>-->

                </Grid>
            </StackPanel>
        </GroupBox>
        <StackPanel Grid.Column="0" Grid.ColumnSpan="6" Grid.Row="7"  Name="pnl_Tipopago"  >
            <Grid Background="Cyan"  >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"  ></ColumnDefinition>
                    <ColumnDefinition Width="25*" ></ColumnDefinition>
                    <ColumnDefinition Width="25*"></ColumnDefinition>

                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="30" MaxHeight="50"></RowDefinition>
                </Grid.RowDefinitions>
                <Label  Grid.Column="0"  Grid.Row="0" Content="Tipo De Pago Anticipo" Height="30" FontWeight="Black"  FontSize="13"  VerticalAlignment="Center"  />
                <RadioButton  Grid.Column="1" Grid.Row="0" Name="rdbeletronico" Content="Eletrónico" VerticalAlignment="Center" IsChecked="True"  ></RadioButton>
                <RadioButton  Grid.Column="2" Grid.Row="0" Name="rdbcheque" Content="Cheque" VerticalAlignment="Center"  ></RadioButton>
            </Grid>
        </StackPanel>

        <Label  Grid.Column="0" Grid.ColumnSpan="6" Grid.Row="8" Content="Observaciones de modificación información bancaria." Height="30"  FontSize="13"  VerticalAlignment="Center"  HorizontalAlignment="Center"  />
        <Border Grid.Column="0" Grid.ColumnSpan="6" Grid.Row="9"   Grid.RowSpan="5" CornerRadius="5" BorderThickness="1" BorderBrush="Black" MinHeight="100" MaxHeight="150">

            <TextBox   Name="txtobservaciones"  TextWrapping="Wrap"  AcceptsReturn="True"
  VerticalScrollBarVisibility="Visible" MaxHeight="150" MinHeight="150" MaxWidth="400" MaxLength="250" KeyUp="TextboxtStringShift_KeyUp"></TextBox>

        </Border>

        <Label  Grid.Column="0" Grid.Row="4" Content="Nombre(s)" Height="30"  FontSize="13"  VerticalAlignment="Center"  />
        <Border Grid.Column="1"  Grid.ColumnSpan="4" Grid.Row="4" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Height="25">
            <TextBox  Name="txtnombres"   Background="Transparent" BorderThickness="0"  Height="25" MaxLength="60" VerticalContentAlignment="Center" FontSize="13"   TabIndex="3"  IsReadOnly="True" />
        </Border>
        <Label Name="lblerror_observaciones"  Grid.Column="0" Grid.ColumnSpan="6" Grid.Row="14" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="auto" Height="30"></Label>
        <Label Name="lblerror_observaciones2"  Grid.Column="0" Grid.ColumnSpan="6" Grid.Row="15" HorizontalAlignment="Center" Foreground="Red"  FontSize="14"   FontWeight="Bold" Width="auto" Height="30"></Label>
        <Button Content="Aceptar" FontFamily="Arial" FontSize="15" FontWeight="Bold" Height="23"  HorizontalAlignment="Center"   Name="btn_aceptar"   Width="76"  Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="16"  VerticalAlignment="Bottom" Click="btn_aceptar_Click" Margin="2,0,55,3.824"  />


        
        <RadioButton IsEnabled="False"  Content="Tercero" Grid.Column="3" HorizontalAlignment="Left"  Grid.Row="3" VerticalAlignment="Center"  Name="radioTercero"/>
        <RadioButton IsEnabled="False"  Content="Propio" Grid.Column="4" HorizontalAlignment="Left"  Grid.Row="3" VerticalAlignment="Center" Name="radiopropio"/>
    </Grid>
</Window>
