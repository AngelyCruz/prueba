                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Switch(IIF(IsNothing(Fields!diasdiferencia.Value),False,True)=False,"No Registra",
Fields!diasdiferencia.Value&gt;0, (Fields!diasdiferencia.Value) &amp; " -Días  Vencido",
Fields!diasdiferencia.Value&gt;-15,(Fields!diasdiferencia.Value * -1) &amp; " -Días  para vencer",
Fields!diasdiferencia.Value&lt;0, (Fields!diasdiferencia.Value * -1) &amp; "  -Días  para vencer"

)</Value>
                              <Style>
                                <FontFamily>Verdana</FontFamily>
                                <FontSize>9pt</FontSize>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
